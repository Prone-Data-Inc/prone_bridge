{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "checkJs": false,
    "paths": {
      "@/*": ["client/src/*"],
      "#shared/*": ["shared/src/*"],
      "#server/*": ["server/src/*"]
    }
  },
  "include": ["client/src", "server/src", "shared/src", "api", "scripts", "brand"],
  "exclude": ["node_modules", "client/dist"]
}
