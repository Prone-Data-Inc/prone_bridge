# ProneBridge environment. Copy to .env and fill in. Never commit .env.
# Only VITE_* keys reach the browser, so never prefix a secret with VITE_.

# App
NODE_ENV=development
PORT=8000
# Public address of the web app (CORS and links)
APP_URL=http://localhost:5173
# true when one server serves both the API and the built app (Docker)
SERVE_CLIENT=false
# debug, info, warn, error, silent
LOG_LEVEL=info
# The demo scenarios and the reset (the Demo button in the toolbar). On by default, since this is a demo. Set false to
# switch them off.
DEMO_TOOLS=true
# Whether the x-forwarded-for header can be believed. Leave empty on Vercel, which sets it itself. Set true only behind
# a proxy of your own: anywhere else the header is ignored, since anyone can type it.
TRUST_PROXY=

# Database: Supabase Postgres (step 2)
# On your machine the direct connection string works. On Vercel use the transaction pooler string (port 6543).
DATABASE_URL=
# The connection is always verified. For a Supabase database the app already carries Supabase's public root
# certificate, so both lines below are optional and only override it. A certificate you give wins.
# A file, for your machine: Supabase's CA certificate (Project settings, Database, SSL configuration).
DATABASE_SSL_CA_FILE=
# The certificate as text, for hosts that keep no files (new lines may be written as \n).
DATABASE_SSL_CA=
# Connections per server instance. Empty means 5 locally and 1 on Vercel.
DATABASE_POOL_MAX=

# PayPal (step 5). Sandbox only, this project never uses live keys.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the webhook you create in the PayPal dashboard (see README)
PAYPAL_WEBHOOK_ID=
# A sandbox account (its email) that receives the seller payouts. Leave empty and payouts stay simulated.
PAYPAL_PAYOUT_EMAIL=

# OpenAI. Use a dedicated key with a monthly spend cap in the OpenAI dashboard.
OPENAI_API_KEY=
# Model ids checked against the OpenAI docs and the account's model list on 2026-11-05.
# The agent model runs the seller copilot. The fast model writes the short risk explanations.
OPENAI_MODEL_AGENT=gpt-6.1-sol
OPENAI_MODEL_FAST=gpt-6-luna
# The most AI tokens the app may use in a day (UTC), across the copilot and the risk explanations. Past it, the copilot
# pauses and risk explanations are written by the rules alone, until the next day.
AI_DAILY_LIMIT=600000

# Browser-safe values only (public by design). The Supabase service role key must never go here,
# or anywhere in this app: the build stops if it finds one in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
