# ProneBridge environment. Copy to .env and fill in. Never commit .env.
# Only VITE_* keys reach the browser, so never prefix a secret with VITE_.

# App
NODE_ENV=development
PORT=8000
# Public address of the web app (CORS and links)
APP_URL=http://localhost:5173
# true when one server serves both the API and the built app (Docker)
SERVE_CLIENT=false
# debug, info, warn, error, silent
LOG_LEVEL=info

# Supabase (step 2)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used only to run migrations from the terminal
DATABASE_URL=

# PayPal (step 5). Sandbox only, this project never uses live keys.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# OpenAI (step 7). Use a dedicated key with a monthly spend cap.
OPENAI_API_KEY=
# Checked against the OpenAI docs before step 7
OPENAI_MODEL_AGENT=gpt-6.1-sol
OPENAI_MODEL_FAST=gpt-6-luna

# Browser-safe values (public by design)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PAYPAL_CLIENT_ID=
